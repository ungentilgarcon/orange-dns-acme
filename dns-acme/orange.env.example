# orange.env.example
# Author: ungentilgarcon (assisted by GitHub Copilot / Copilot CLI)
# License: GPL-3.0-or-later - see LICENSE at the repository root
#
# Copy to a location OUTSIDE of source control (e.g. ~/acme-scripts/orange.env)
# and `source` it before running acme.sh, or export these vars in your
# crontab / Task Scheduler action. Never commit real credentials.

export OA_USERNAME="your-iam-username"
export OA_PASSWORD="your-iam-password"
export OA_DOMAIN_NAME="your-otc-account-domain-name"
export OA_PROJECT_NAME="eu-west-0"
export OA_REGION="eu-west-0"

# --- Email notifications sent by run-renew.sh after each renewal check ---
export NOTIFY_EMAIL="you@example.com"
# Set to 0 to only be emailed on failure (default 1 = email on every run)
export NOTIFY_EMAIL_ON_SUCCESS=1

# run-renew.sh tries msmtp, then mail/mailx, then sendmail - whichever is
# installed/configured first. If you don't already have a local MTA
# (postfix/ssmtp) or msmtp configured, the easiest is msmtp relaying via an
# external SMTP account:
#   sudo apt-get install -y msmtp msmtp-mta
#   cat > ~/.msmtprc <<'EOF'
#   defaults
#   auth           on
#   tls            on
#   tls_trust_file /etc/ssl/certs/ca-certificates.crt
#
#   account        default
#   host           smtp.example.com
#   port           587
#   user           smtp-user
#   password       smtp-password
#   from           alerts@example.com
#   EOF
#   chmod 600 ~/.msmtprc

# Optional overrides (only needed if Orange changes endpoints or you use a
# different region than eu-west-0):
# export OA_IAM_ENDPOINT="https://iam.eu-west-0.prod-cloud-ocb.orange-business.com"
# export OA_DNS_ENDPOINT="https://dns.eu-west-0.prod-cloud-ocb.orange-business.com"
